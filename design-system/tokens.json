{
  "color-fg": {
    "$type": "color",
    "$value": {
      "colorSpace": "srgb",
      "components": [0.102, 0.122, 0.169],
      "hex": "#1a1f2b"
    },
    "$description": "Default body text color. Paired with color-bg it clears WCAG AA (4.5:1) for normal text."
  },
  "color-bg": {
    "$type": "color",
    "$value": {
      "colorSpace": "srgb",
      "components": [1, 1, 1],
      "hex": "#ffffff"
    },
    "$description": "Default page/surface background."
  },
  "color-primary": {
    "$type": "color",
    "$value": {
      "colorSpace": "srgb",
      "components": [0.114, 0.306, 0.847],
      "hex": "#1d4ed8"
    },
    "$description": "Brand accent for primary actions and links."
  },
  "color-primary-fg": {
    "$type": "color",
    "$value": {
      "colorSpace": "srgb",
      "components": [1, 1, 1],
      "hex": "#ffffff"
    },
    "$description": "Text/icon color on top of color-primary surfaces."
  },
  "color-border": {
    "$type": "color",
    "$value": {
      "colorSpace": "srgb",
      "components": [0.847, 0.875, 0.906],
      "hex": "#d8dfe7"
    },
    "$description": "Default hairline border for cards, inputs, and dividers."
  },
  "color-muted-fg": {
    "$type": "color",
    "$value": {
      "colorSpace": "srgb",
      "components": [0.376, 0.42, 0.486],
      "hex": "#606b7c"
    },
    "$description": "Secondary text: captions, helper text, timestamps."
  },
  "color-surface-raised": {
    "$type": "color",
    "$value": {
      "colorSpace": "srgb",
      "components": [0.973, 0.98, 0.992],
      "hex": "#f8fafd"
    },
    "$description": "Background for cards and panels that sit above color-bg."
  },
  "color-danger": {
    "$type": "color",
    "$value": {
      "colorSpace": "srgb",
      "components": [0.722, 0.11, 0.11],
      "hex": "#b81c1c"
    },
    "$description": "Destructive actions and error states."
  },
  "space-1": {
    "$type": "dimension",
    "$value": { "value": 4, "unit": "px" },
    "$description": "Tightest spacing: icon-to-label gaps, chip padding."
  },
  "space-2": {
    "$type": "dimension",
    "$value": { "value": 8, "unit": "px" },
    "$description": "Compact spacing: form control padding, small gaps."
  },
  "space-3": {
    "$type": "dimension",
    "$value": { "value": 16, "unit": "px" },
    "$description": "Default spacing: card padding, section gaps."
  },
  "space-4": {
    "$type": "dimension",
    "$value": { "value": 24, "unit": "px" },
    "$description": "Generous spacing: page gutters, between major blocks."
  },
  "radius-sm": {
    "$type": "dimension",
    "$value": { "value": 4, "unit": "px" },
    "$description": "Chips, badges, small controls."
  },
  "radius-md": {
    "$type": "dimension",
    "$value": { "value": 8, "unit": "px" },
    "$description": "Buttons, inputs, default control radius."
  },
  "radius-lg": {
    "$type": "dimension",
    "$value": { "value": 16, "unit": "px" },
    "$description": "Cards and modals."
  },
  "font-size-sm": {
    "$type": "dimension",
    "$value": { "value": 12, "unit": "px" },
    "$description": "Captions, helper text, table metadata."
  },
  "font-size-md": {
    "$type": "dimension",
    "$value": { "value": 14, "unit": "px" },
    "$description": "Default body text and form controls."
  },
  "font-size-lg": {
    "$type": "dimension",
    "$value": { "value": 20, "unit": "px" },
    "$description": "Section headings and card titles."
  },
  "font-family-base": {
    "$type": "fontFamily",
    "$value": "system-ui, -apple-system, 'Segoe UI', sans-serif",
    "$description": "Default UI typeface stack."
  },
  "font-weight-regular": {
    "$type": "fontWeight",
    "$value": 400
  },
  "font-weight-semibold": {
    "$type": "fontWeight",
    "$value": 600
  },
  "border-width-default": {
    "$type": "dimension",
    "$value": { "value": 1, "unit": "px" },
    "$description": "Hairline border width used across inputs, cards, chips."
  },
  "shadow-card": {
    "$type": "shadow",
    "$value": {
      "color": {
        "colorSpace": "srgb",
        "components": [0.102, 0.122, 0.169],
        "alpha": 0.08,
        "hex": "#1a1f2b"
      },
      "offsetX": { "value": 0, "unit": "px" },
      "offsetY": { "value": 2, "unit": "px" },
      "blur": { "value": 8, "unit": "px" },
      "spread": { "value": 0, "unit": "px" }
    },
    "$description": "Resting elevation for raised cards and panels."
  },
  "button-primary-background": {
    "$type": "color",
    "$value": "{color-primary}"
  },
  "button-primary-foreground": {
    "$type": "color",
    "$value": "{color-primary-fg}"
  },
  "button-primary-radius": {
    "$type": "dimension",
    "$value": "{radius-md}"
  },
  "button-secondary-background": {
    "$type": "color",
    "$value": "{color-bg}"
  },
  "button-secondary-foreground": {
    "$type": "color",
    "$value": "{color-primary}"
  },
  "button-secondary-border": {
    "$type": "color",
    "$value": "{color-border}"
  },
  "card-default-background": {
    "$type": "color",
    "$value": "{color-surface-raised}"
  },
  "card-default-border": {
    "$type": "color",
    "$value": "{color-border}"
  },
  "card-default-radius": {
    "$type": "dimension",
    "$value": "{radius-lg}"
  },
  "card-default-padding": {
    "$type": "dimension",
    "$value": "{space-3}"
  }
}
